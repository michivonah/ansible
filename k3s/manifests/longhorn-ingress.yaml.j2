apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata: 
  name: longhorn-frontend-ingress
  namespace: longhorn-system
spec:
  entryPoints:
    - web
  routes:
    - match: Host(`{{ longhorn_frontend_host }}`)
      kind: Rule
      services:
        - name: longhorn-frontend
          port: 80