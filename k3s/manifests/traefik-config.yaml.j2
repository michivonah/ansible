# Docs: https://docs.k3s.io/add-ons/helm#customizing-packaged-components-with-helmchartconfig
# Helm Config Options: https://github.com/traefik/traefik-helm-chart/blob/master/traefik/VALUES.md

apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    deployment:
      replicas: {{ k3s_traefik_replicas | default(2) }}

    {% if k3s_traefik_host | default(false) %}
api:
      dashboard: true
    {% endif %}

    providers:
      kubernetesGateway:
        enabled: {{ traefik_enable_gateway_api | default(false) }}