---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard-ingress
  namespace: kube-system
spec:
  entryPoints:
  {% for entrypoint in k3s_traefik_entrypoints %}
    - {{ entrypoint }}
  {% endfor -%}
  routes:
    - match: Host(`{{ k3s_traefik_host }}`)
      kind: Rule

    {% if traefik_basicauth_username | default(false) and traefik_basicauth_password | default(false) %}
  middlewares:
        - name: traefik-dashboard-auth
    {% endif %}

      services:
        - name: api@internal
          kind: TraefikService